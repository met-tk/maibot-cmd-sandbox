{
  "manifest_version": 2,
  "id": "maibot-cmd-sandbox",
  "version": "1.5.0",
  "name": "沙盒终端与全能系统控制 | Sandbox Terminal & Full System Control",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "terminal"
    }
  },
  "description": "为麦麦提供多显示器桌面截图、文件安全读写与沙盒约束、终端命令执行、进程管理、应用启动及系统电源控制，支持私聊与指定授权群聊自然语言及前缀指令。",
  "author": {
    "name": "met-tk",
    "url": "https://github.com/met-tk"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/met-tk/maibot-cmd-sandbox",
    "homepage": "https://github.com/met-tk/maibot-cmd-sandbox",
    "documentation": "https://github.com/met-tk/maibot-cmd-sandbox#readme",
    "issues": "https://github.com/met-tk/maibot-cmd-sandbox/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.9.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.9.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=9.0.0"
    },
    {
      "type": "python_package",
      "name": "mss",
      "version_spec": ">=9.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "config.get",
    "chat.get_private_streams",
    "chat.get_stream_by_user_id",
    "chat.get_group_streams",
    "chat.get_stream_by_group_id",
    "message.get_recent"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
